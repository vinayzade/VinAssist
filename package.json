{
  "name": "VinAssist",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "npm run android:dev",
    "android:dev": "react-native run-android --mode developmentDebug",
    "android:staging": "react-native run-android --mode stagingDebug --appId com.vinassist.staging",
    "android:prod": "react-native run-android --mode productionRelease --appId com.vinassist",
    "android:apk:staging": "cd android && gradlew assembleStagingRelease",
    "android:aab:prod": "cd android && gradlew bundleProductionRelease",
    "ios": "npm run ios:dev",
    "ios:dev": "react-native run-ios --scheme VinAssist",
    "ios:staging": "react-native run-ios --scheme VinAssist-Staging",
    "ios:prod": "react-native run-ios --scheme VinAssist-Production --mode Release",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-documents/picker": "^12.0.2",
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@reduxjs/toolkit": "^2.12.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-config": "^1.7.2",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.27.0",
    "react-native-vision-camera": "^5.2.3",
    "react-native-worklets": "^0.12.2",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "VinAssistSpec",
    "type": "modules",
    "jsSrcsDir": "src/native/specs",
    "android": {
      "javaPackageName": "com.vinassist.nativemodules"
    }
  }
}
