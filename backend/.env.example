# Copy to `.env` for local development. `.env` is git-ignored; never commit it.
# Every value has a safe default in app/core/config.py.

APP_ENV=development
APP_NAME=AI SmartAssist
LOG_LEVEL=INFO
DEBUG=true

# Async driver is required (asyncpg). Format:
#   postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smartassist
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Comma-separated. The React Native app does not send an Origin header, so
# this only matters for browser-based tools (Swagger UI, admin dashboards).
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Uploaded documents are stored on disk under this directory (never in the DB).
STORAGE_DIR=./storage
MAX_PDF_BYTES=20971520
MAX_IMAGE_BYTES=10485760

# Auth. Generate a real secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# AI provider (backend only; the mobile app never talks to a vendor directly).
#   mock        - deterministic, offline, no key (default)
#   huggingface - Hugging Face Inference API; needs HUGGINGFACE_API_KEY
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=60
# HUGGINGFACE_API_KEY=hf_...
# Override any model id without code changes:
# HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HF_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
# HF_SUMMARIZATION_MODEL=facebook/bart-large-cnn
# HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# HF_EMBEDDING_DIMENSIONS=384
# HF_VISION_MODEL=Salesforce/blip-image-captioning-large
