# Copy to `.env` for a local override, or edit the per-environment files:
#   .env.development  .env.staging  .env.production
#
# RULES
#  - Only PUBLIC, non-secret values belong here. Everything in these files is
#    compiled into the app binary and is readable by anyone who installs it.
#  - AI provider keys (Hugging Face, OpenAI, Anthropic, ...) live ONLY in the
#    FastAPI backend. The app talks to our backend, never to a provider.
#  - `src/config/env.ts` validates these at startup and refuses to run if a
#    variable looks like a secret.

APP_ENV=development
API_BASE_URL=http://10.0.2.2:8000
